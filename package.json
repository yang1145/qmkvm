{
  "name": "pinhaoji",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:www": "pnpm --filter @pinhaoji/www dev",
    "dev:portal": "pnpm --filter @pinhaoji/portal dev",
    "dev:admin": "pnpm --filter @pinhaoji/admin dev",
    "dev:api": "pnpm --filter @pinhaoji/api dev",
    "dev:worker": "pnpm --filter @pinhaoji/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @pinhaoji/db generate",
    "db:migrate": "pnpm --filter @pinhaoji/db migrate",
    "db:seed": "pnpm --filter @pinhaoji/db seed"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
