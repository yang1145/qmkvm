{
  "name": "@qmkvm/db",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "reset": "tsx --env-file=../../.env src/reset.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
