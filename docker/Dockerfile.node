# API / Worker 共用镜像：ARG APP=api|worker
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.node --build-arg APP=api -t kvm-api .
FROM node:22-alpine AS base
# 构建应用包名（api|worker…）：必须显式 ARG 声明，否则 compose 的 build-arg 不注入，下面的
# ${APP} 会展开成空 → WORKDIR 变 /app/apps/、--filter 匹配所有包，导致 CMD pnpm start 找不到 start 脚本
ARG APP=api
# npm 源走镜像加速（corepack 下载 pnpm 本体也走它）；海外可用 --build-arg NPM_REGISTRY=https://registry.npmjs.org 覆盖
ARG NPM_REGISTRY=https://registry.npmmirror.com
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
# store-dir 显式固定，配合下方 RUN --mount=type=cache 跨构建复用 pnpm store（reused>0）；
# 去掉 network-concurrency=1（串行放大单请求卡顿），抬高超时/重试对抗 registry 偶发卡顿
RUN corepack enable && printf 'registry=%s\nfetch-timeout=300000\nfetch-retries=8\nstore-dir=/root/.local/share/pnpm/store\n' "${NPM_REGISTRY}" > /root/.npmrc
WORKDIR /app

# 依赖层（lockfile 不变时命中缓存）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/db/package.json packages/db/
COPY packages/logger/package.json packages/logger/
COPY packages/contracts/package.json packages/contracts/
COPY packages/core/package.json packages/core/
COPY packages/auth/package.json packages/auth/
COPY packages/payments/package.json packages/payments/
COPY packages/provisioning/package.json packages/provisioning/
COPY packages/notifications/package.json packages/notifications/
COPY packages/config/tsconfig.base.json packages/config/tsconfig.base.json
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @qmkvm/${APP}... --ignore-scripts

# 源码层
COPY packages ./packages
COPY apps/${APP} ./apps/${APP}
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @qmkvm/${APP}... --ignore-scripts

WORKDIR /app/apps/${APP}
# 环境变量由 compose env_file 注入；迁移在部署流程中执行（pnpm --filter @qmkvm/db migrate）
CMD ["pnpm", "start:prod"]
