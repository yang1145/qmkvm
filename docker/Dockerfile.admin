# Ant Design Pro 管理后台：构建产物由 nginx 托管
# API 地址统一构建期注入（跨域直连，不用反代）：--build-arg ADMIN_API_URL=https://api.example.com
# 需将 admin 域名加入 api 的 CORS_ORIGINS；dev 模式可留空走 umi 本地 proxy
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.admin -t kvm-admin .
FROM node:22-alpine AS builder
# npm 源走镜像加速（corepack 下载 pnpm 本体也走它）；海外可用 --build-arg NPM_REGISTRY=https://registry.npmjs.org 覆盖
ARG NPM_REGISTRY=https://registry.npmmirror.com
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
# store-dir 显式固定，配合下方 RUN --mount=type=cache 跨构建复用 pnpm store（reused>0）；
# 去掉 network-concurrency=1（串行放大单请求卡顿），抬高超时/重试对抗 registry 偶发卡顿
RUN corepack enable && printf 'registry=%s\nfetch-timeout=300000\nfetch-retries=8\nstore-dir=/root/.local/share/pnpm/store\n' "${NPM_REGISTRY}" > /root/.npmrc
WORKDIR /app

ARG ADMIN_API_URL

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/admin/package.json apps/admin/
COPY packages/config/tsconfig.base.json packages/config/tsconfig.base.json
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @qmkvm/admin --ignore-scripts

COPY apps/admin ./apps/admin
WORKDIR /app/apps/admin
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @qmkvm/admin --ignore-scripts \
  && pnpm build

FROM nginx:1.27-alpine AS runner
COPY docker/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html
EXPOSE 80
