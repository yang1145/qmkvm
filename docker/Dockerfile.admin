# Ant Design Pro 管理后台：构建产物由 nginx 托管
# API 模式二选一（构建期烘焙，改配置需重建）：
#   同源反代（缺省）：不设 ADMIN_API_URL，nginx-admin.conf 的 /api 反代承担
#   独立域名直连：--build-arg ADMIN_API_URL=https://api.example.com（需 CORS_ORIGINS 收录 admin 域名）
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.admin -t kvm-admin .
FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app

ARG ADMIN_API_URL

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/admin/package.json apps/admin/
COPY packages/config/tsconfig.base.json packages/config/tsconfig.base.json
RUN pnpm install --frozen-lockfile --filter @qmkvm/admin --ignore-scripts

COPY apps/admin ./apps/admin
WORKDIR /app/apps/admin
RUN pnpm install --frozen-lockfile --filter @qmkvm/admin --ignore-scripts \
  && pnpm build

FROM nginx:1.27-alpine AS runner
COPY docker/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html
EXPOSE 80
