# 公网 HTTPS 入口镜像：域名分流 + ACME HTTP-01 免费证书自动签发/续期
# nginx + acme.sh，域名经 .env 传入（GATEWAY_*_DOMAIN），逻辑见 docker/gateway/entrypoint.sh
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.gateway -t kvm-gateway .
FROM nginx:1.27-alpine

RUN apk add --no-cache curl openssl git \
  && git clone --depth 1 https://github.com/acmesh-official/acme.sh /opt/acme.sh \
  && chmod +x /opt/acme.sh/acme.sh

COPY docker/gateway/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 80/443 需公网可达（HTTP-01 验证走 80）；由 compose ports 映射
EXPOSE 80 443
ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
