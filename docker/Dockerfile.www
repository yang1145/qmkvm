# www 官网静态导出镜像：SSG 产物 out/ 由 nginx 托管，无 Node 运行时
# 注意：NEXT_PUBLIC_* 在构建期烘焙进产物，改配置需重新 build（不像 portal 可运行时注入）
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.www -t kvm-www .
FROM node:22-alpine AS builder
# npm 源走镜像加速（corepack 下载 pnpm 本体也走它）；海外可用 --build-arg NPM_REGISTRY=https://registry.npmjs.org 覆盖
ARG NPM_REGISTRY=https://registry.npmmirror.com
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
# store-dir 显式固定，配合下方 RUN --mount=type=cache 跨构建复用 pnpm store（reused>0）；
# 去掉 network-concurrency=1（串行放大单请求卡顿），抬高超时/重试对抗 registry 偶发卡顿
RUN corepack enable && printf 'registry=%s\nfetch-timeout=300000\nfetch-retries=8\nstore-dir=/root/.local/share/pnpm/store\n' "${NPM_REGISTRY}" > /root/.npmrc
WORKDIR /app

ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_PORTAL_URL
ARG NEXT_PUBLIC_BRAND_NAME
ARG NEXT_PUBLIC_BRAND_NAME_EN
# 品牌定制拉取端点（GET /api/v1/public/settings）；未配置时用 NEXT_PUBLIC_* / 内置缺省
ARG BRANDING_API_URL

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config/tsconfig.base.json packages/config/tsconfig.base.json
COPY apps/www/package.json apps/www/
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @qmkvm/www... --ignore-scripts

COPY packages ./packages
COPY apps/www ./apps/www
# 品牌内容指纹（API 响应 sha256）：内容变化 → 指纹变化 → 仅下方构建层缓存失效，
# 依赖安装层保持复用；未导出时为空，与上次相同则命中缓存（由发布/重建命令负责导出）。
ARG BRANDING_HASH
WORKDIR /app/apps/www
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @qmkvm/www... --ignore-scripts \
  && pnpm build

# 运行层：纯静态托管
FROM nginx:1.27-alpine AS runner
COPY docker/nginx-www.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/www/out /usr/share/nginx/html
EXPOSE 80
