# portal 客户中心镜像：SPA/静态导出（output:'export'），out/ 由 nginx 托管，无 Node 运行时
# 注意：NEXT_PUBLIC_API_URL 在构建期烘焙进产物，改 API 地址需重新 build
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.next -t kvm-portal .
FROM node:22-alpine AS builder
# npm 源走镜像加速（corepack 下载 pnpm 本体也走它）；海外可用 --build-arg NPM_REGISTRY=https://registry.npmjs.org 覆盖
ARG NPM_REGISTRY=https://registry.npmmirror.com
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
# store-dir 显式固定，配合下方 RUN --mount=type=cache 跨构建复用 pnpm store（reused>0）；
# 去掉 network-concurrency=1（串行放大单请求卡顿），抬高超时/重试对抗 registry 偶发卡顿
RUN corepack enable && printf 'registry=%s\nfetch-timeout=300000\nfetch-retries=8\nstore-dir=/root/.local/share/pnpm/store\n' "${NPM_REGISTRY}" > /root/.npmrc
WORKDIR /app

ARG NEXT_PUBLIC_API_URL

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/portal/package.json apps/portal/
COPY packages/config/tsconfig.base.json packages/config/tsconfig.base.json
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @qmkvm/portal... --ignore-scripts

COPY packages ./packages
COPY apps/portal ./apps/portal
WORKDIR /app/apps/portal
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @qmkvm/portal... --ignore-scripts \
  && pnpm build

# 运行层：纯静态托管（详情页走查询参数，路由即静态 HTML，try_files 直配）
FROM nginx:1.27-alpine AS runner
COPY docker/nginx-portal.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/portal/out /usr/share/nginx/html
EXPOSE 80
