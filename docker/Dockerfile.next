# portal 客户中心镜像：SPA/静态导出（output:'export'），out/ 由 nginx 托管，无 Node 运行时
# 注意：NEXT_PUBLIC_API_URL 在构建期烘焙进产物，改 API 地址需重新 build
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.next -t kvm-portal .
FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app

ARG NEXT_PUBLIC_API_URL

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/portal/package.json apps/portal/
COPY packages/config/tsconfig.base.json packages/config/tsconfig.base.json
RUN pnpm install --frozen-lockfile --filter @qmkvm/portal... --ignore-scripts

COPY packages ./packages
COPY apps/portal ./apps/portal
WORKDIR /app/apps/portal
RUN pnpm install --frozen-lockfile --filter @qmkvm/portal... --ignore-scripts \
  && pnpm build

# 运行层：纯静态托管（详情页走查询参数，路由即静态 HTML，try_files 直配）
FROM nginx:1.27-alpine AS runner
COPY docker/nginx-portal.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/portal/out /usr/share/nginx/html
EXPOSE 80
