{
  "name": "@pinhaoji/admin",
  "version": "0.1.0",
  "private": true,
  "description": "拼好机云业务系统管理后台（Ant Design Pro）",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "dev": "cross-env UMI_ENV=dev max dev",
    "preview": "max preview --port 8000",
    "start": "cross-env UMI_ENV=dev max dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "biome": "biome check --write"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "^3.1.14-2",
    "@pinhaoji/contracts": "workspace:*",
    "antd": "^6.6.0",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@umijs/max": "^4.7.3",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}