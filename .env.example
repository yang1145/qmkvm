# ===== 基础 =====
NODE_ENV=development
LOG_LEVEL=info

# 数据库（MySQL 8，utf8mb4）
# 主备形态：本值指向"固定写入口"（VIP / 数据库代理 / 云 RDS 端点），
# 故障转移发生在入口之下，切换时本值不变。单库部署直接填主库地址。
DATABASE_URL=mysql://user:pass@host:3306/qmkvm
# 只读从库（可选：三节点主备/主从部署时指向从库，报表/导出/审计检索/dashboard
# 走从库；不配置则这些读路径回落主库，单机部署零配置兼容。强一致读始终走主库）
# DATABASE_URL_RO=mysql://user:pass@readonly-host:3306/qmkvm
# 备库探测连接串（可选：worker 的 system.replica_health 复制健康告警用；
# 探测账号需 REPLICATION CLIENT 权限，见 docs/deployment.md §6.2。
# 未配置时 replica_health 只探测从库）
# DATABASE_URL_STANDBY=mysql://user:pass@standby-host:3306/qmkvm

# Redis（可选：配置后启用 BullMQ 队列与分布式限流；不配置则 API 内存降级 + 任务内联执行）
REDIS_URL=

# 应用密钥：32 字节 base64，用于 AES-256-GCM 加密敏感配置与证件号
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=

# ===== API =====
API_PORT=4000
# 前端来源白名单（逗号分隔），同时用于 CORS 与 CSRF Origin 校验
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:4000
# 生产环境跨子域共享 Cookie 时设置为 .example.com（替换为你的域名）
COOKIE_DOMAIN=
# API 公网回调地址（支付网关 webhook notifyUrl 用，如 https://api.example.com）；
# 未配置时回落 PORTAL_URL，生产必须显式配置（网关需能从公网回调到 API）
# API_PUBLIC_URL=https://api.example.com

# ===== 管理后台（apps/admin）=====
# 独立域名部署（构建期烘焙，改后需重建 admin）：设为 API 绝对地址，前端跨域直连；
# 需将 admin 域名加入 CORS_ORIGINS。不设置则走同源相对路径（/api 反代模式）
# ADMIN_API_URL=https://api.example.com

# 各前端地址（支付回跳、通知链接等使用）
WWW_URL=http://localhost:3000
PORTAL_URL=http://localhost:3001
ADMIN_URL=http://localhost:8000
# www 官网对外域名（OG/canonical/sitemap 使用；不硬编码，缺省 https://example.com）
NEXT_PUBLIC_SITE_URL=

# 开发辅助：允许 mock 支付端点（生产必须 false）
DEV_MOCK_PAYMENTS=true

# ===== 通知 =====
# mock | aliyun
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="启明智联 <noreply@example.com>"

# 运维告警（钉钉/飞书机器人 webhook）
ALERT_WEBHOOK_URL=

# ===== 附件 =====
UPLOAD_DIR=./uploads

# ===== 存储抽象（@qmkvm/storage）=====
# local=本地盘（缺省，行为与历史版本一致，文件落 UPLOAD_DIR）；s3=S3 兼容对象存储（MinIO/阿里 OSS/腾讯 COS 等）
STORAGE_PROVIDER=local
# S3 各项（STORAGE_PROVIDER=s3 时必填/按需；本地盘模式可全部留空）
# MinIO 示例：STORAGE_S3_ENDPOINT=http://minio.example.com:9000
# 阿里 OSS 示例：STORAGE_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 腾讯 COS 示例：STORAGE_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET=
# 同一 bucket 承载多环境时的 key 前缀（如 dev/、prod/），可留空
STORAGE_S3_BUCKET_PREFIX=

# ===== 种子 =====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345

# ===== www 官网（apps/www）=====
# 品牌名（构建时注入客户端包；不设置则用 lib/site.ts 中的缺省值）
# 更换品牌：推荐在 admin「站点信息」设置并配 BRANDING_API_URL 重新构建 www；
# 无业务系统时也可设置以下两项 + 替换 apps/www/public/ 下的 logo 图片，文案无需改动
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_NAME_EN=
# 品牌定制拉取端点（www 构建前 fetch 烘焙 branding.json；未配置/失败降级 env 与内置缺省）
# BRANDING_API_URL=http://127.0.0.1:4000/api/v1/public/settings
# Portal（用户控制台）地址：配置后 www 主 CTA 变为「进入控制台」并在页脚展示控制台入口；
# 不配置则主 CTA 回落为「申请试用」，不渲染控制台入口（避免死链）
# NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
# 联系销售表单提交端点（www 为 SSG 静态导出，无内置 API）：指向接收表单的服务
# （如 apps/api 公开端点或第三方表单服务）；构建期烘焙，未配置时表单提交提示失败
# NEXT_PUBLIC_CONTACT_API_URL=https://api.example.com/v1/contact
